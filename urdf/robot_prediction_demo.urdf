<?xml version="1.0"?>
<robot name="robot_prediction_demo">
  <material name="blue">
    <color rgba="0.15 0.35 0.85 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="gray">
    <color rgba="0.65 0.65 0.65 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.1 0.7 0.2 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.85 0.2 0.2 1.0"/>
  </material>
  <material name="yellow">
    <color rgba="0.95 0.85 0.15 0.85"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.20 0.12"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <link name="left_side_marker">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.02 0.05"/>
      </geometry>
      <material name="green"/>
    </visual>
  </link>

  <joint name="left_side_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_side_marker"/>
    <origin xyz="0 0.11 0.08" rpy="0 0 0"/>
  </joint>

  <link name="right_side_marker">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.02 0.05"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="right_side_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_side_marker"/>
    <origin xyz="0 -0.11 0.08" rpy="0 0 0"/>
  </joint>

  <link name="front_marker">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.18 0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="front_marker_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_marker"/>
    <origin xyz="0.145 0 0.08" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.04"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.10 0 0.18" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <link name="camera_view_link">
    <visual>
      <origin xyz="0.18 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.36 0.20 0.02"/>
      </geometry>
      <material name="yellow"/>
    </visual>
  </link>

  <joint name="camera_view_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_view_link"/>
    <origin xyz="0.02 0 0" rpy="0 0 0"/>
  </joint>
</robot>
